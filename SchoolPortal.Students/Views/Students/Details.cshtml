@model Student

@{
    ViewData["Title"] = "Student Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold gradient-text mb-2">Student Profile</h1>
    <p class="text-gray-400">View detailed student information</p>
</div>

<!-- Profile Card -->
<div class="max-w-xl mx-auto">
    <div class="glass-card rounded-3xl overflow-hidden">
        <div class="h-1 bg-gradient-to-r from-neon-cyan via-neon-purple to-neon-pink"></div>
        
        <div class="p-8">
            <!-- Avatar & Name -->
            <div class="text-center mb-8">
                <div class="w-24 h-24 rounded-full bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center mx-auto mb-4 text-4xl font-bold text-white shadow-lg shadow-neon-cyan/30">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
                <h2 class="text-3xl font-bold text-white mb-1">@Model.FirstName @Model.LastName</h2>
                <span class="text-gray-500 font-mono">ID: #@Model.Id</span>
            </div>

            <!-- Info Grid -->
            <div class="space-y-4">
                <div class="p-4 rounded-xl bg-dark-card/50 border border-dark-border">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-neon-cyan/10 flex items-center justify-center">
                            <i class="bi bi-envelope text-neon-cyan"></i>
                        </div>
                        <div>
                            <p class="text-gray-500 text-sm">Email Address</p>
                            <p class="text-white font-medium">@Model.Email</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-dark-card/50 border border-dark-border">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-neon-purple/10 flex items-center justify-center">
                            <i class="bi bi-calendar-event text-neon-purple"></i>
                        </div>
                        <div>
                            <p class="text-gray-500 text-sm">Date of Birth</p>
                            <p class="text-white font-medium">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-dark-card/50 border border-dark-border">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-neon-pink/10 flex items-center justify-center">
                            <i class="bi bi-clock-history text-neon-pink"></i>
                        </div>
                        <div>
                            <p class="text-gray-500 text-sm">Enrollment Date</p>
                            <p class="text-white font-medium">@Model.EnrollmentDate.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-between pt-6 mt-6 border-t border-dark-border">
                <a asp-action="Index" 
                   class="px-6 py-3 rounded-xl border border-dark-border text-gray-400 hover:text-white hover:border-gray-500 transition-all duration-300 flex items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Back to Directory
                </a>
                <div class="flex items-center gap-3">
                    <a href="http://localhost:5002/Grades/Create?studentId=@Model.Id"
                       class="px-6 py-3 bg-gradient-to-r from-neon-cyan to-neon-purple rounded-xl font-semibold text-white hover:shadow-lg hover:shadow-neon-cyan/30 transition-all duration-300 flex items-center gap-2">
                        <i class="bi bi-journal-plus"></i> Add Grade
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" 
                       class="px-6 py-3 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-xl font-semibold text-dark-bg hover:shadow-lg hover:shadow-yellow-400/30 transition-all duration-300 flex items-center gap-2">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
