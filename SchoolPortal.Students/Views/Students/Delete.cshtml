@model Student

@{
    ViewData["Title"] = "Delete Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-red-400 mb-2">Delete Student</h1>
    <p class="text-gray-400">Permanently remove student from the system</p>
</div>

<!-- Delete Card -->
<div class="max-w-xl mx-auto">
    <div class="glass-card rounded-3xl overflow-hidden border border-red-500/30">
        <div class="h-1 bg-gradient-to-r from-red-500 to-red-600"></div>
        
        <div class="p-8 text-center">
            <!-- Warning Icon -->
            <div class="w-20 h-20 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-exclamation-triangle text-red-400 text-4xl"></i>
            </div>

            <h2 class="text-2xl font-bold text-white mb-2">Are you sure?</h2>
            <p class="text-gray-400 mb-6">You are about to permanently delete the student account for:</p>

            <!-- Student Info -->
            <div class="p-6 rounded-xl bg-dark-card/50 border border-dark-border mb-6">
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-red-400/30 to-red-600/30 flex items-center justify-center mx-auto mb-3 text-xl font-bold text-red-300">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
                <h3 class="text-xl font-bold text-white">@Model.FirstName @Model.LastName</h3>
                <p class="text-gray-400 text-sm">@Model.Email</p>
            </div>

            <!-- Warning Box -->
            <div class="p-4 rounded-xl bg-yellow-500/10 border border-yellow-500/30 text-left mb-6">
                <div class="flex items-start gap-3">
                    <i class="bi bi-shield-exclamation text-yellow-400 text-xl"></i>
                    <div>
                        <p class="text-yellow-400 font-semibold">Warning</p>
                        <p class="text-yellow-400/80 text-sm">This action cannot be undone. All database tracking records linked to this ID will lose access.</p>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" class="flex items-center justify-between">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" 
                   class="px-6 py-3 rounded-xl border border-dark-border text-gray-400 hover:text-white hover:border-gray-500 transition-all duration-300 flex items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Cancel, Keep Student
                </a>
                <button type="submit" 
                        class="px-6 py-3 bg-gradient-to-r from-red-500 to-red-600 rounded-xl font-semibold text-white hover:shadow-lg hover:shadow-red-500/30 transition-all duration-300 flex items-center gap-2">
                    <i class="bi bi-trash"></i> Yes, Delete Account
                </button>
            </form>
        </div>
    </div>
</div>
