@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold gradient-text mb-2">Privacy Policy</h1>
    <p class="text-gray-400">Your privacy is important to us</p>
</div>

<!-- Privacy Content -->
<div class="glass-card rounded-3xl overflow-hidden max-w-4xl">
    <div class="h-1 bg-gradient-to-r from-neon-cyan via-neon-purple to-neon-pink"></div>
    
    <div class="p-8 space-y-6">
        <div>
            <h2 class="text-xl font-bold text-neon-cyan mb-3 flex items-center gap-2">
                <i class="bi bi-shield-check"></i> Data Collection
            </h2>
            <p class="text-gray-300 leading-relaxed">
                SchoolPortal collects and stores student information including names, email addresses, and dates of birth for academic management purposes. All data is stored securely and is only accessible to authorized personnel.
            </p>
        </div>

        <div class="border-t border-dark-border pt-6">
            <h2 class="text-xl font-bold text-neon-purple mb-3 flex items-center gap-2">
                <i class="bi bi-lock"></i> Data Security
            </h2>
            <p class="text-gray-300 leading-relaxed">
                We implement industry-standard security measures to protect your personal information. All data transmissions are encrypted, and access to student records is logged and monitored.
            </p>
        </div>

        <div class="border-t border-dark-border pt-6">
            <h2 class="text-xl font-bold text-neon-pink mb-3 flex items-center gap-2">
                <i class="bi bi-database"></i> Data Usage
            </h2>
            <p class="text-gray-300 leading-relaxed">
                Student data is used exclusively for educational administration, grade management, and academic record keeping. We do not sell or share personal information with third parties.
            </p>
        </div>

        <div class="border-t border-dark-border pt-6">
            <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-person-circle"></i> Your Rights
            </h2>
            <p class="text-gray-300 leading-relaxed">
                Students have the right to access, correct, or request deletion of their personal data. Contact the system administrator for any privacy-related inquiries.
            </p>
        </div>

        <div class="border-t border-dark-border pt-6">
            <p class="text-gray-500 text-sm">
                Last updated: January 2026 | SchoolPortal &copy; 2026
            </p>
        </div>
    </div>
</div>
