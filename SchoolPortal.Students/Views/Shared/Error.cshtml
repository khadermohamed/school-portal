@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
        <!-- Error Icon -->
        <div class="w-32 h-32 rounded-full bg-gradient-to-br from-red-500/20 to-red-600/10 border border-red-500/30 flex items-center justify-center mx-auto mb-8">
            <i class="bi bi-exclamation-triangle text-red-400 text-6xl"></i>
        </div>

        <!-- Error Code -->
        <h1 class="text-8xl font-bold gradient-text mb-4">Error</h1>
        
        <!-- Message -->
        <h2 class="text-2xl font-semibold text-white mb-3">Something went wrong</h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto">
            An unexpected error occurred while processing your request. Please try again or contact support if the problem persists.
        </p>

        <!-- Actions -->
        <div class="flex items-center justify-center gap-4">
            <a asp-controller="Home" asp-action="Index" 
               class="px-6 py-3 neon-border rounded-xl text-neon-cyan font-semibold hover:bg-neon-cyan/10 transition-all duration-300 flex items-center gap-2">
                <i class="bi bi-house"></i> Go Home
            </a>
            <button onclick="history.back()" 
                    class="px-6 py-3 rounded-xl border border-dark-border text-gray-400 hover:text-white hover:border-gray-500 transition-all duration-300 flex items-center gap-2">
                <i class="bi bi-arrow-left"></i> Go Back
            </button>
        </div>

        <!-- Support Info -->
        <div class="mt-12 p-4 rounded-xl bg-dark-card/50 border border-dark-border inline-flex items-center gap-3 text-gray-500 text-sm">
            <i class="bi bi-info-circle"></i>
            <span>If this error persists, please contact system administrator</span>
        </div>
    </div>
</div>
