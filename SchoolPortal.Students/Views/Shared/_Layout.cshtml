<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolPortal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'neon-cyan': '#00f5ff',
                        'neon-purple': '#bf00ff',
                        'neon-pink': '#ff00e4',
                        'dark-bg': '#0a0a0f',
                        'dark-card': '#12121a',
                        'dark-border': '#2a2a3a'
                    },
                    animation: {
                        'gradient': 'gradient 8s ease infinite',
                        'float': 'float 6s ease-in-out infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate'
                    }
                }
            }
        }
    </script>
    <style>
        @@keyframes gradient {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        @@keyframes glow {
            from { box-shadow: 0 0 20px rgba(0, 245, 255, 0.3); }
            to { box-shadow: 0 0 30px rgba(0, 245, 255, 0.6); }
        }
        .gradient-text {
            background: linear-gradient(135deg, #00f5ff, #bf00ff, #ff00e4);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .glass-card {
            background: rgba(18, 18, 26, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(42, 42, 58, 0.5);
        }
        .neon-border {
            border: 1px solid transparent;
            background: linear-gradient(#12121a, #12121a) padding-box,
                        linear-gradient(135deg, #00f5ff, #bf00ff, #ff00e4) border-box;
        }
        body {
            background: linear-gradient(135deg, #0a0a0f 0%, #1a0a2e 50%, #0a0a0f 100%);
            min-height: 100vh;
        }
        .floating-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.3;
            pointer-events: none;
            z-index: 0;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="text-white min-h-screen relative overflow-x-hidden">
    <!-- Floating Decorative Orbs -->
    <div class="floating-orb w-96 h-96 bg-neon-purple top-0 left-0 animate-float"></div>
    <div class="floating-orb w-80 h-80 bg-neon-cyan bottom-0 right-0 animate-float" style="animation-delay: -3s;"></div>
    <div class="floating-orb w-64 h-64 bg-neon-pink top-1/2 left-1/2 animate-float" style="animation-delay: -1.5s;"></div>

    <!-- Navigation -->
    <nav class="relative z-10 glass-card border-b border-dark-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center">
                        <i class="bi bi-mortarboard-fill text-white text-xl"></i>
                    </div>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-bold gradient-text">
                        SchoolPortal
                    </a>
                </div>
                <div class="flex items-center gap-6">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area="" asp-controller="Students" asp-action="Index" 
                           class="text-gray-300 hover:text-neon-cyan transition-colors duration-300 font-medium flex items-center gap-2">
                            <i class="bi bi-people-fill"></i> Students
                        </a>
                    }
                    <a asp-area="" asp-controller="Home" asp-action="Privacy"
                       class="text-gray-400 hover:text-neon-purple transition-colors duration-300">
                        Privacy
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 glass-card border-t border-dark-border mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center">
                        <i class="bi bi-mortarboard-fill text-white text-sm"></i>
                    </div>
                    <span class="text-gray-400">&copy; 2026 SchoolPortal. All rights reserved.</span>
                </div>
                <div class="flex items-center gap-4">
                    <span class="flex items-center gap-2 text-sm text-gray-500">
                        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                        System Online
                    </span>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
