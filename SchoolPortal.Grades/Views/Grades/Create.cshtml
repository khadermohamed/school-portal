@model SchoolPortal.Grades.Models.Grade

@{
    ViewData["Title"] = "Add New Grade";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-purple-500 mb-6 animate-pulse-glow">       
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
        </div>
        <h1 class="text-4xl font-black mb-4">
            <span class="gradient-text">Add New Grade</span>
        </h1>
        <p class="text-gray-400">Record a new academic achievement</p>
    </div>

    <!-- Form Card -->
    <div class="glass rounded-2xl overflow-hidden">
        <div class="h-1 bg-gradient-to-r from-cyan-500 via-purple-500 to-pink-500"></div>

        <form asp-action="Create" class="p-8 space-y-6">
            <div asp-validation-summary="ModelOnly" class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 text-red-400"></div>

            <!-- Student ID -->
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-300">
                    <span class="flex items-center space-x-2">
                        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span>Student ID</span>
                    </span>
                </label>
                <div class="relative">
                    <select name="StudentId" id="StudentId" class="w-full bg-[#111827]/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all appearance-none cursor-pointer">
                        <option value="" class="bg-gray-800 text-white">-- Select a Student --</option>
                        @if (ViewBag.StudentsList != null)
                        {
                            foreach (var student in (SelectList)ViewBag.StudentsList)
                            {
                                <option value="@student.Value" class="bg-gray-800 text-white">@student.Text</option>
                            }
                        }
                    </select>
                    <!-- Custom Dropdown Arrow -->
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                </div>
                <span asp-validation-for="StudentId" class="text-red-400 text-sm"></span>
            </div>

            <!-- Course Name -->
            <div class="space-y-2">
                <label asp-for="CourseName" class="block text-sm font-medium text-gray-300">
                    <span class="flex items-center space-x-2">
                        <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                        <span>Course Name</span>
                    </span>
                </label>
                <input asp-for="CourseName" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" placeholder="Enter course name" />
                <span asp-validation-for="CourseName" class="text-red-400 text-sm"></span>
            </div>

            <!-- Score -->
            <div class="space-y-2">
                <label asp-for="Score" class="block text-sm font-medium text-gray-300">
                    <span class="flex items-center space-x-2">
                        <svg class="w-4 h-4 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                        </svg>
                        <span>Score</span>
                    </span>
                </label>
                <div class="relative">
                    <input asp-for="Score" type="number" step="0.1" min="0" max="100" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-pink-500 focus:ring-1 focus:ring-pink-500 transition-all" placeholder="Enter score (0-100)" />       
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">/100</div>
                </div>
                <span asp-validation-for="Score" class="text-red-400 text-sm"></span>
            </div>

            <!-- Grade Date -->
            <div class="space-y-2">
                <label asp-for="GradeDate" class="block text-sm font-medium text-gray-300">
                    <span class="flex items-center space-x-2">
                        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span>Grade Date</span>
                    </span>
                </label>
                <input asp-for="GradeDate" type="date" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all" />
                <span asp-validation-for="GradeDate" class="text-red-400 text-sm"></span>
            </div>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 pt-6">
                <button type="submit" class="btn-cyber flex-1 flex items-center justify-center space-x-2 px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-500 text-white font-semibold hover:shadow-lg hover:shadow-cyan-500/25 transition-all duration-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Create Grade</span>
                </button>
                <a asp-action="Index" class="flex-1 flex items-center justify-center space-x-2 px-6 py-3 rounded-xl bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-all duration-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span>Cancel</span>
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
